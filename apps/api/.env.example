# Oracle Autonomous Database (Free Tier)
# Requer o driver "oracledb" (npm install oracledb) e, quando aplicável,
# o Oracle Instant Client configurado no ambiente antes de conectar.
DB_HOST=
DB_PORT=1521
DB_USERNAME=
DB_PASSWORD=
DB_SERVICE_NAME=

# Chave simétrica para cifrar tokens/segredos em repouso (RNF-SEC-01).
# Gere com: openssl rand -base64 32
# Em produção, gerenciar via KMS (Oracle Cloud Vault/KMS), não como env solto.
KMS_DATA_KEY=

# Sessão Bimo (emitida após o login OAuth externo, RF-AUTH-01/02/03)
JWT_SECRET=

# Google OAuth (RF-AUTH-01) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Microsoft Entra ID / Graph (RF-AUTH-02) — https://entra.microsoft.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback
