# Oracle Autonomous Database (Free Tier). mTLS é obrigatório nesse tier, então
# a conexão precisa da Wallet baixada no console (Database Connection >
# Download Wallet) — NUNCA comitar os arquivos da wallet no git.
#
# Passo a passo:
#   1. Extraia o zip da Wallet em uma pasta fora do repositório (ex:
#      ~/oracle-wallets/bimodb/, ou apps/api/wallet/ — já está no .gitignore
#      se preferir manter dentro do projeto).
#   2. Exporte TNS_ADMIN apontando pra essa pasta antes de rodar a API:
#        export TNS_ADMIN=/caminho/para/a/wallet
#      (o processo Node precisa dessa env var — o driver oracledb lê o
#      tnsnames.ora de lá para resolver o alias de DB_CONNECT_STRING).
#   3. Preencha DB_CONNECT_STRING com um dos aliases do tnsnames.ora
#      (ex: bimodb_medium — bom equilíbrio de paralelismo/concorrência para
#      uma API web; bimodb_high para lotes/migração, bimodb_low para o mais leve).
#   4. Preencha DB_WALLET_LOCATION com o mesmo caminho do TNS_ADMIN, e
#      DB_WALLET_PASSWORD com a senha que você escolheu ao baixar a wallet.
#
# DB_HOST/DB_PORT/DB_SERVICE_NAME abaixo só são usados como fallback quando
# DB_CONNECT_STRING está vazio (ex: um Oracle local sem mTLS para dev).
DB_CONNECT_STRING=
DB_WALLET_LOCATION=
DB_WALLET_PASSWORD=
DB_HOST=
DB_PORT=1521
DB_USERNAME=ADMIN
DB_PASSWORD=
DB_SERVICE_NAME=

# Chave simétrica para cifrar tokens/segredos em repouso (RNF-SEC-01).
# Gere com: openssl rand -base64 32
# Em produção, gerenciar via KMS (Oracle Cloud Vault/KMS), não como env solto.
KMS_DATA_KEY=

# Sessão Bimo (emitida após o login OAuth externo, RF-AUTH-01/02/03)
JWT_SECRET=

# Google OAuth (RF-AUTH-01) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Microsoft Entra ID / Graph (RF-AUTH-02) — https://entra.microsoft.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback

# Worker de sincronização embutido no processo da API (Fase 2).
# Deixe "false" ao rodar só testes/lint locais sem banco disponível.
WORKERS_ENABLED=false

# Para onde o navegador volta após o login OAuth (RF-AUTH-01/02)
FRONTEND_URL=http://localhost:3001

# Provisionamento de novo tenant (RF-ADMIN-01) — ação operacional da
# equipe Bimo, não um fluxo self-service público. Gere com openssl rand -hex 32.
ADMIN_BOOTSTRAP_SECRET=

# Resumo periódico semanal por professor (RF-DASH-06). Mesmo padrão do
# WORKERS_ENABLED: deixe "false" em testes/CI sem banco disponível.
PERIODIC_SUMMARY_ENABLED=false
